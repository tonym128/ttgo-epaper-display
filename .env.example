# ==========================================
# Environment Configuration Template
# Copy this file to '.env' and fill in your details:
#   cp .env.example .env
# ==========================================

# Wi-Fi Credentials
WIFI_SSID="YOUR_WIFI_SSID"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# Weather Location Settings
# Find your coordinates at https://www.latlong.net/
LOCATION_NAME="Sydney"
LATITUDE="-33.8688"
LONGITUDE="151.2093"
TIMEZONE="Australia/Sydney"

# Picture Frame Web Admin Password
DEFAULT_ADMIN_PASS="admin"

# ==========================================
# Smart E-Paper Badge Defaults
# ==========================================
BADGE_DEFAULT_NAME="Your Name"
BADGE_DEFAULT_TITLE="Software Engineer"
BADGE_DEFAULT_COMPANY="Your Company"
BADGE_DEFAULT_HANDLE="@yourhandle"
BADGE_DEFAULT_QR="https://github.com/yourname"

# Luggage Tag Defaults
BADGE_LUGGAGE_PHONE="+1 555-0199"
BADGE_LUGGAGE_EMAIL="you@example.com"
BADGE_LUGGAGE_NOTE="Reward if returned intact!"
